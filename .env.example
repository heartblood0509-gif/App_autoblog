# ============================================================
# AutoBlog 개발용 환경변수 템플릿
#
# 사용법:
#   1. 이 파일을 .env로 복사:
#        cp .env.example .env
#   2. 아래 빈 값들을 본인 값으로 채움
#   3. .env 파일은 자동으로 git 제외됨 (.gitignore에 등록)
#
# ⚠️ 절대 이 값들을 코드에 직접 하드코딩하거나 커밋하지 마세요.
#    (프로덕션에서는 keyring/OS 자격증명 관리자를 사용)
# ============================================================


# --- Google Gemini API (PoC 3에 필요) ---
# 발급 경로: https://aistudio.google.com/app/apikey
# 형식: AIzaSy... 로 시작하는 39자 문자열
# 권장: 발급 후 Google Cloud Console에서 spending cap 설정 (월 10,000원 등)
GEMINI_API_KEY=


# --- 네이버 테스트 계정 (PoC 2~4에 필요, 향후용) ---
# ⚠️ 메인 계정 절대 금지. 잃어도 상관없는 계정만 사용.
# 현재 PoC 2 스크립트는 브라우저에서 수동 로그인을 대기하므로
# 이 값들은 지금은 사용되지 않지만, 향후 자동화를 위해 채워두세요.
NAVER_TEST_USERNAME=
NAVER_TEST_PASSWORD=


# --- (선택) 추가 Google 계정 ---
# GOOGLE_API_KEY=  # GEMINI_API_KEY와 동일 효과 (구글 SDK가 둘 다 인식)
